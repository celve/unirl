# =============================================================================
# DiffusionRL Environment Variables
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# =============================================================================

# --- Wandb ---
WANDB_API_KEY=xxx

# --- OpenAI ---
OPENAI_API_KEY=xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Gemini ---
GEMINI_API_KEY=xxx

# --- Self-deployed API (e.g. reward model, custom LLM) ---
CUSTOM_API_KEY=xxx
CUSTOM_BASE_URL=http://localhost:8000/v1
